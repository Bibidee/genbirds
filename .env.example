# Browser-facing values (NEXT_PUBLIC_*). These ship to the client.
NEXT_PUBLIC_GENLAYER_CONTRACT_ADDRESS=0xcde8C50A9Ed6Ebf2027219B141E74227379383d7
NEXT_PUBLIC_GENBIRDS_CONTRACT_ADDRESS=0xcde8C50A9Ed6Ebf2027219B141E74227379383d7

# IMPORTANT: this is the SAME-ORIGIN proxy URL, not the upstream RPC.
# The browser must NEVER call the real GenLayer RPC directly.
NEXT_PUBLIC_GENLAYER_RPC_URL=/api/genlayer-rpc

NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_EXPLORER_BASE=https://explorer-studio.genlayer.com

# Server-only. The actual upstream RPC the proxy will forward to.
# Never expose with NEXT_PUBLIC_ — the browser must not see this.
GENLAYER_RPC_URL=https://studio.genlayer.com:8443/api
